{
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/auth.js": {
      "maxDuration": 30
    },
    "api/drive.js": {
      "maxDuration": 30
    },
    "api/strategy-bot.js": {
      "maxDuration": 30
    },
    "api/usage.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:route",
      "destination": "/api/auth?__route=:route"
    },
    {
      "source": "/api/drive/:route",
      "destination": "/api/drive?__route=:route"
    }
  ]
}
