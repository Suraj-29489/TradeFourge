{
  "manifest_version": 3,
  "name": "TradeFourge Companion",
  "version": "5.1.2",
  "description": "Official TradeFourge Companion Extension v5.1.2 — Definitive Context Recovery & Heartbeat Stabilization",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TradeFourge Companion"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.tradefourge.com/*",
      "https://*.vercel.app/*",
      "https://tradefourge.vercel.app/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.tradefourge.com/*",
        "https://*.vercel.app/*",
        "https://tradefourge.vercel.app/*"
      ],
      "js": ["dist/injector.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://my.exness.com/*",
        "https://my.exness.org/*",
        "https://my.exness.link/*",
        "https://my.exness.me/*",
        "https://terminal.exness.com/*",
        "https://terminal.exness.org/*",
        "https://terminal.exness.link/*",
        "https://terminal.exness.me/*",
        "https://*.exness.com/*",
        "https://*.exness.org/*",
        "https://*.exness.link/*",
        "https://*.exness.me/*",
        "https://*.exness-trade.com/*",
        "https://*.exness-trade.pro/*",
        "https://*.exness.cloud/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/content.js",
        "dist/background.js",
        "dist/injector.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ]
}
