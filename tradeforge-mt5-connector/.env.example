# TradeForge MT5 Connector Configuration

# TradeForge Production Backend API Base URL
TRADEFORGE_API_URL=http://localhost:3000

# Sync Intervals (seconds)
HEARTBEAT_INTERVAL_SEC=60
ACCOUNT_SYNC_INTERVAL_SEC=60
HISTORY_SYNC_INTERVAL_SEC=300
RECONCILIATION_INTERVAL_SEC=3600

# History & Ingestion Settings
INITIAL_HISTORY_DAYS=365
INCREMENTAL_OVERLAP_MINUTES=5
BATCH_SIZE=500

# Optional: Path to custom terminal64.exe if non-standard installation
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Logging Level (DEBUG, INFO, WARNING, ERROR)
TRADEFORGE_LOG_LEVEL=INFO
