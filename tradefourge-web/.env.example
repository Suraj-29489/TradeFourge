# TradeFourge Environment Variables Template (Safe to Commit)
# Copy this file to .env.local for local development and set matching variables
# in Vercel Project Settings -> Environment Variables before deploying.
#
# SECURITY: NEVER commit .env.local or expose GOOGLE_CLIENT_SECRET or SESSION_SECRET in frontend code.

# Required for Fourge AI Server-Side Gemini Router (/api/strategy-bot)
GEMINI_API_KEY=

# Google Cloud Project: TradeFourge Authentication (ID: tradefourge-authentication)
# Application type: Web application
# Authorized JavaScript origins:
#   - http://localhost:3000
#   - https://tradefourge.vercel.app
# Authorized redirect URIs:
#   - http://localhost:3000/api/auth/callback
#   - https://tradefourge.vercel.app/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Strong random secret (>= 32 chars) used for AES-256-GCM HttpOnly session encryption and OAuth state HMAC.
# Example generator: openssl rand -hex 32
SESSION_SECRET=
