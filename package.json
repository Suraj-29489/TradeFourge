{
  "name": "tradefourge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TradeFourge Monorepo — Web Application, Companion Extension, Backend & Database",
  "scripts": {
    "dev:web": "npm run dev --prefix tradefourge-web",
    "build:web": "npm run build --prefix tradefourge-web",
    "start:web": "npm run start --prefix tradefourge-web",
    "lint:web": "npm run lint --prefix tradefourge-web",
    "check:extension": "powershell -Command \"Get-ChildItem -Path tradefourge-extension -Recurse -Filter '*.js' | ForEach-Object { node --check $($_.FullName) }\""
  },
  "workspaces": [
    "tradefourge-web"
  ]
}
